# Configuración del orquestador. Copiar a /opt/plane-app/orchestrator.env en la
# instancia y rellenar los secretos. chmod 600: el GITHUB_TOKEN puede mergear
# código.
#
# Este archivo es una plantilla y NO debe contener secretos reales.

DATABASE_URL=postgresql://plane:<POSTGRES_PASSWORD de plane.env>@plane-db:5432/orchestrator

# --- Plane -------------------------------------------------------------
PLANE_BASE_URL=https://plane.camuflex.com

# IMPORTANTE: este token tiene que generarse desde la cuenta del BOT.
# Plane atribuye cada acción al dueño del token, y el filtro anti-bucle
# compara contra PLANE_BOT_USER_ID. Con el token del admin, las acciones del
# orquestador se atribuirían al admin, el filtro no coincidiría y el sistema
# se realimentaría en bucle infinito.
PLANE_API_KEY=

# Secreto del webhook de Plane, tal como se configuró en el webhook del proyecto.
PLANE_WEBHOOK_SECRET=

# Usuario bot (bot@camuflex.com). Es `member.id`, no el id de la fila de
# membresía del workspace.
PLANE_BOT_USER_ID=eea8b7cb-5ecd-426c-a740-1a64bcfef307

# --- Cursor ------------------------------------------------------------
CURSOR_API_KEY=
# Grok 4.6, thinking high, fast. Los defaults del orquestador son estos;
# se pueden omitir. Para otro modelo: GET https://api.cursor.com/v1/models
CURSOR_MODEL=grok-4.6
CURSOR_MODEL_PARAMS=effort=high,fast=true

# --- GitHub ------------------------------------------------------------
# Necesita permisos de contenido y pull requests sobre los repos automatizados.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- Cadencias (opcionales, con valores por defecto razonables) ---------
# WORKER_POLL_MS=2000
# RECONCILE_INTERVAL_MS=300000
# AGENT_STALE_MINUTES=60
