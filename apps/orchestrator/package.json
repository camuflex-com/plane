{
  "name": "orchestrator",
  "version": "1.4.2",
  "private": true,
  "description": "Cierra el ciclo Plane -> Cursor -> GitHub -> Plane: encola agentes, revisa con Bugbot y mergea",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/start.mjs",
  "module": "./dist/start.mjs",
  "exports": {
    ".": "./dist/start.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "dev": "tsdown --watch --no-clean --onSuccess \"node --env-file=.env .\"",
    "start": "node .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lint": "oxlint .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "express": "catalog:",
    "pg": "8.13.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.11.10",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
